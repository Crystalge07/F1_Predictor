# --- Python build/runtime clutter ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environment (each machine makes its own) ---
.venv/

# --- Local data ---
# The SQLite database (and its backups) are large and can always be rebuilt
# by running the backfill script, so they never go into git.
data/
# ...except the dashboard's test data: a small export of the simulated test
# world, committed so the React tests run anywhere (scripts/export_test_data.py).
!web/src/test/data/

# --- Tooling caches ---
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor files ---
.DS_Store
.vscode/
.idea/

# --- Secrets (e.g. the OpenWeatherMap API key in a later phase) ---
.env

# --- The dashboard site, built by the workflow (web/ + the data export) ---
site/
